{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.3",
  "developer": {
    "name": "Mample",
    "url": "https://mample.vercel.app"
  },
  "author": "Mample",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": [
    "notifications",
    "storage",
    "activeTab",
    "downloads"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content-script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Mample"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}