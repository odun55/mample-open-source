# Defaults to Mample's public support page when unset.
# Set an empty value to hide the payment button.
NEXT_PUBLIC_SUPPORT_URL=https://buymeacoffee.com/mample

# Real Google Play listing URL. The badge stays inactive while empty.
NEXT_PUBLIC_GOOGLE_PLAY_URL=
# Canonical origin used by metadata, structured data, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://mample.app
